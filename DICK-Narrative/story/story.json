{
  "name": "钟楼之下",
  "intro": "示例故事包。把这份 story.json 换成你自己的，程序就会读它。",
  "roles": [
    { "name": "薇拉", "sprite": "sprites/vera.png", "voice": "" },
    { "name": "管家", "sprite": "sprites/butler.png", "voice": "" }
  ],
  "scenes": [
    {
      "id": "s1",
      "title": "序章 · 门厅",
      "key": true,
      "images": [],
      "lines": [
        { "kind": "bg", "bg": "bg/hall.png" },
        { "kind": "bgm", "bgm": "bgm/theme.ogg" },
        { "kind": "note", "note": "雨敲在彩窗上，门厅里只有一座停摆的钟。" },
        { "kind": "say", "speaker": "管家", "text": "小姐，客人到了。" },
        { "kind": "say", "speaker": "薇拉", "text": "……让他进来吧。这里已经很久没有活人的脚步声了。" },
        {
          "kind": "choice",
          "choice": [
            { "text": "行礼，报上姓名", "goto": "s2" },
            { "text": "沉默地站着", "goto": "s2" },
            { "text": "「这座钟，是停在哪一年？」", "goto": "s3", "if": { "aff": ">=50" } }
          ]
        }
      ]
    },
    {
      "id": "s2",
      "title": "第一章 · 会客室",
      "next": "s4",
      "lines": [
        { "kind": "bg", "bg": "bg/parlor.png" },
        { "kind": "say", "speaker": "薇拉", "text": "坐吧。你想问的事，我未必答得上来。" },
        { "kind": "setflag", "flag": { "k": "met", "v": true } },
        { "kind": "effect", "effect": "flash" },
        { "kind": "note", "note": "灯芯爆了一下。" }
      ]
    },
    {
      "id": "s3",
      "title": "第一章 · 那座钟",
      "next": "s4",
      "lines": [
        { "kind": "say", "speaker": "薇拉", "text": "……一九〇三年。你倒是第一个问这个的。" },
        { "kind": "setflag", "flag": { "k": "clock", "v": true } },
        { "kind": "say", "speaker": "薇拉", "text": "跟我来。", "effect": "shake" }
      ]
    },
    {
      "id": "s4",
      "title": "终章 · 钟楼",
      "lines": [
        { "kind": "bg", "bg": "bg/tower.png" },
        { "kind": "say", "speaker": "薇拉", "text": "钟摆一动，时间就会往前走。你确定要替它上发条？" },
        { "kind": "note", "note": "（他曾经问过那座钟。）", "if": { "flags": ["clock"] } },
        { "kind": "end", "end": "钟楼之下 · 完" }
      ]
    }
  ]
}
