# ============ DICK .gitignore ============
# 隐私数据（角色卡/聊天记录/设置）
saves/
worlds/
personas/
config.json
workshop_config.json
memory/
quick_replies.json
financial_history.json
# 用户自定义生图预设（内置预设写死在 image_gen.py，这个是用户覆盖层）
image_presets.json

# API Key / 密钥（任何地方）
*.key
.env

# 构建产物
build/
dist/
DICK-HTML/
DICK.zip
*.exe
*.apk
installer_screenshot.png
_install_test/
_zh_test/

# Python 环境/缓存
utau_env/
__pycache__/
*.pyc
tts_cache/
codex/

# Android 构建
DICK-Android/build/
DICK-Android/.gradle/
DICK-Android/.kotlin/
DICK-Android/app/build/
*.apk
local.properties
*.jks

# Kotlin 叙事播放器（DICK-Narrative）
DICK-Narrative/.gradle/
DICK-Narrative/.kotlin/
DICK-Narrative/app/build/
DICK-Narrative/build/
# 播放器打包产物（127MB，绝不进仓库）
DICK-Narrative-播放器/
DICK-Narrative/app/build/compose/binaries/

# 插件设置（含用户配置）
plugin_settings/

# 日志
*.log
debug.log

# 编辑器/系统
.idea/
.vscode/
.DS_Store
Thumbs.db

# 安装器下载的临时产物
tavern-installer/tavern/
tavern-installer/tavern.zip
tavern-installer/start.bat

# 测试临时
_apk_inspect/
_kt_test_data/
_mock/
_ui_evidence/

# 开发临时脚本（下划线开头）
/_*.py
/_*.bat
/_*.kt
/_*.ps1
/_*.txt
/_*.js
/_*.html
/_wf/.wrangler/

# DSH 环境目录（不属于 DICK 项目）
/dsh-vision-router/
/dsh-whale-pet/
/dskin/
/.dsh-vision-router/

# Cloudflare Workers 本地开发目录
/_wf/

workshop_data/

# 新增：机器/构建产物（绝不能进仓库）
tavern-installer/node/
server_build/
DICK-HTML.zip
*.bak
aoqi_crawler.py

# DSH 环境目录
/dsh-companion/

# 手机工具链素材（Termux rootfs / debs，约 42MB / 2700+ 文件）—— 是移植素材，不是源码
_phone/

# 开发临时数据：下划线开头的老规则只覆盖了 py/bat/kt/ps1/txt/js/html，漏了 json
# （_turns.json、_selfscore_data*.json 这类实验输出会漏进来）
/_*.json

# 跑测试/脚本留下的临时目录
/_tmp*/

# 测试用 tempfile.mkdtemp 的产物：本机 venv（utau_env）里 tempfile 会退化成工作目录，
# 于是 mkdtemp 出来的目录全落在项目根 —— 是垃圾，不是源码（/dick_*/ 只匹配目录，不碰 .py）
/tmp*/
/dick_*/
/sg_*/

# 临时截图/出图样本（验证生图、UI 截图这类）
/_*.jpg
/_*.jpeg
/_*.png
/_*.webp
